<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="top.jsp" %><h3>Ürün Formu</h3><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/admin/products" class="card p-3"><input type="hidden" name="id" value="${product.id}"><label>Kategori</label><select name="categoryId" class="form-select mb-2" required><option value="">Seçiniz</option><c:forEach var="c" items="${categories}"><option value="${c.id}" ${product.categoryId==c.id?'selected':''}>${c.name}</option></c:forEach></select><label>Ürün Adı</label><input class="form-control mb-2" name="name" value="${product.name}" required><label>Açıklama</label><textarea class="form-control mb-2" name="description">${product.description}</textarea><label>Fiyat</label><input class="form-control mb-2" name="price" type="number" step="0.01" min="0.01" value="${product.price}" required><label>Stok</label><input class="form-control mb-2" name="stock" type="number" min="0" value="${product.stock}" required><label>Görsel URL</label><input class="form-control mb-2" name="imageUrl" value="${product.imageUrl}"><label><input type="checkbox" name="active" ${product.active||product.id==0?'checked':''}> Aktif</label><button class="btn btn-primary mt-2">Kaydet</button></form><%@ include file="bottom.jsp" %>
