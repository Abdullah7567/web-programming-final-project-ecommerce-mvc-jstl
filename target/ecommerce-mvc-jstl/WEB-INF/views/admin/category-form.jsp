<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="top.jsp" %><h3>Kategori Formu</h3><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form method="post" action="${pageContext.request.contextPath}/admin/categories" class="card p-3"><input type="hidden" name="id" value="${category.id}"><label>Ad</label><input class="form-control mb-2" name="name" value="${category.name}" required><label>Açıklama</label><textarea class="form-control mb-2" name="description">${category.description}</textarea><label><input type="checkbox" name="active" ${category.active||category.id==0?'checked':''}> Aktif</label><button class="btn btn-primary mt-2">Kaydet</button></form><%@ include file="bottom.jsp" %>
