<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="top.jsp" %><div class="d-flex justify-content-between"><h3>Kategoriler</h3><a class="btn btn-success" href="${pageContext.request.contextPath}/admin/category-form">Yeni Kategori</a></div><table class="table bg-white"><tr><th>ID</th><th>Ad</th><th>Açıklama</th><th>Aktif</th><th></th></tr><c:forEach var="c" items="${categories}"><tr><td>${c.id}</td><td>${c.name}</td><td>${c.description}</td><td>${c.active?'Evet':'Hayır'}</td><td><a class="btn btn-sm btn-warning" href="${pageContext.request.contextPath}/admin/category-form?id=${c.id}">Düzenle</a><form class="d-inline" method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${c.id}"><button class="btn btn-sm btn-danger">Pasif Yap</button></form></td></tr></c:forEach></table><%@ include file="bottom.jsp" %>
