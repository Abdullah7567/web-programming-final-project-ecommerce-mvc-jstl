<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="top.jsp" %><h3>Siparişler</h3><table class="table bg-white"><tr><th>ID</th><th>Müşteri</th><th>Tarih</th><th>Toplam</th><th>Durum</th><th>Güncelle</th><th></th></tr><c:forEach var="o" items="${orders}"><tr><td>${o.id}</td><td>${o.customerName}</td><td><fmt:formatDate value="${o.orderDate}" pattern="dd.MM.yyyy HH:mm"/></td><td><fmt:formatNumber value="${o.totalAmount}" type="currency" currencySymbol="₺"/></td><td>${o.status}</td><td><form method="post" class="d-flex gap-1"><input type="hidden" name="id" value="${o.id}"><select name="status" class="form-select form-select-sm"><option ${o.status=='Beklemede'?'selected':''}>Beklemede</option><option ${o.status=='Hazırlanıyor'?'selected':''}>Hazırlanıyor</option><option ${o.status=='Kargoya Verildi'?'selected':''}>Kargoya Verildi</option><option ${o.status=='Tamamlandı'?'selected':''}>Tamamlandı</option><option ${o.status=='İptal Edildi'?'selected':''}>İptal Edildi</option></select><button class="btn btn-sm btn-primary">Kaydet</button></form></td><td><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/admin/order-detail?id=${o.id}">Detay</a></td></tr></c:forEach></table><%@ include file="bottom.jsp" %>
