<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="includes/header.jsp" %>
<div class="card"><div class="row g-0"><div class="col-md-5"><img class="img-fluid rounded-start w-100" src="${product.imageUrl}" onerror="this.src='https://via.placeholder.com/600x400?text=Urun'"></div><div class="col-md-7"><div class="card-body"><h2>${product.name}</h2><p>${product.description}</p><p>Kategori: <b>${product.categoryName}</b></p><p>Stok: ${product.stock}</p><h4><fmt:formatNumber value="${product.price}" type="currency" currencySymbol="₺"/></h4><c:choose><c:when test="${product.stock>0}"><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="productId" value="${product.id}"><input type="number" min="1" max="${product.stock}" name="quantity" value="1" class="form-control w-25 mb-2"><button class="btn btn-primary">Sepete Ekle</button></form></c:when><c:otherwise><div class="alert alert-danger">Stokta Yok</div></c:otherwise></c:choose></div></div></div></div>
<%@ include file="includes/footer.jsp" %>
