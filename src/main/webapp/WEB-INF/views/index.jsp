<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="includes/header.jsp" %>
<div class="row"><aside class="col-md-3"><form class="mb-3"><input class="form-control mb-2" name="q" placeholder="Ürün ara" value="${q}"><button class="btn btn-primary w-100">Ara</button></form><div class="list-group"><a class="list-group-item" href="${pageContext.request.contextPath}/">Tüm Ürünler</a><c:forEach var="cat" items="${categories}"><a class="list-group-item ${selectedCategory==cat.id?'active':''}" href="?categoryId=${cat.id}">${cat.name}</a></c:forEach></div></aside><section class="col-md-9"><h3>Aktif Ürünler</h3><div class="row g-3"><c:forEach var="p" items="${products}"><div class="col-md-4"><div class="card h-100"><img class="card-img-top" src="${p.imageUrl}" onerror="this.src='https://via.placeholder.com/300x180?text=Urun'" alt="${p.name}"><div class="card-body"><h5>${p.name}</h5><p class="small text-muted">${p.description}</p><p class="fw-bold"><fmt:formatNumber value="${p.price}" type="currency" currencySymbol="₺"/></p><c:choose><c:when test="${p.stock>0}"><span class="badge bg-success">Stokta: ${p.stock}</span></c:when><c:otherwise><span class="badge bg-danger">Stokta Yok</span></c:otherwise></c:choose></div><div class="card-footer d-flex gap-2"><a class="btn btn-outline-primary btn-sm" href="${pageContext.request.contextPath}/product?id=${p.id}">Detay</a><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="productId" value="${p.id}"><button class="btn btn-primary btn-sm" ${p.stock==0?'disabled':''}>Sepete Ekle</button></form></div></div></div></c:forEach></div></section></div>
<%@ include file="includes/footer.jsp" %>
