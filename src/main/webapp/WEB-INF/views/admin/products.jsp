<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="top.jsp" %><div class="d-flex justify-content-between"><h3>Ürünler</h3><a class="btn btn-success" href="${pageContext.request.contextPath}/admin/product-form">Yeni Ürün</a></div><table class="table table-sm bg-white"><tr><th>ID</th><th>Ad</th><th>Kategori</th><th>Fiyat</th><th>Stok</th><th>Aktif</th><th></th></tr><c:forEach var="p" items="${products}"><tr><td>${p.id}</td><td>${p.name}</td><td>${p.categoryName}</td><td><fmt:formatNumber value="${p.price}" type="currency" currencySymbol="₺"/></td><td>${p.stock}</td><td>${p.active?'Evet':'Hayır'}</td><td><a class="btn btn-sm btn-warning" href="${pageContext.request.contextPath}/admin/product-form?id=${p.id}">Düzenle</a><form class="d-inline" method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${p.id}"><button class="btn btn-sm btn-danger">Pasif Yap</button></form></td></tr></c:forEach></table><%@ include file="bottom.jsp" %>
