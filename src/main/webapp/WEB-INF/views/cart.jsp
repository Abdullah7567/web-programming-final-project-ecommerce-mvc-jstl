<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="includes/header.jsp" %>
<h3>Sepet</h3><c:choose><c:when test="${empty sessionScope.cart}"><div class="alert alert-info">Sepetiniz boş.</div></c:when><c:otherwise><table class="table table-bordered bg-white"><tr><th>Ürün</th><th>Birim Fiyat</th><th>Adet</th><th>Ara Toplam</th><th></th></tr><c:forEach var="i" items="${sessionScope.cart}"><tr><td>${i.product.name}</td><td><fmt:formatNumber value="${i.product.price}" type="currency" currencySymbol="₺"/></td><td><form class="d-flex gap-1" method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="update"><input type="hidden" name="productId" value="${i.product.id}"><input class="form-control" type="number" name="quantity" min="1" max="${i.product.stock}" value="${i.quantity}"><button class="btn btn-sm btn-secondary">Güncelle</button></form></td><td><fmt:formatNumber value="${i.subtotal}" type="currency" currencySymbol="₺"/></td><td><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="productId" value="${i.product.id}"><button class="btn btn-danger btn-sm">Çıkar</button></form></td></tr></c:forEach><tr><th colspan="3">Genel Toplam</th><th colspan="2"><fmt:formatNumber value="${cartTotal}" type="currency" currencySymbol="₺"/></th></tr></table><form method="post" action="${pageContext.request.contextPath}/checkout"><button class="btn btn-success">Sipariş Oluştur</button></form></c:otherwise></c:choose>
<%@ include file="includes/footer.jsp" %>
